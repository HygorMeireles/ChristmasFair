<% content_for :title, t("dashboard.page_title") %>

<section class="hero-banner">
  <div class="event-logo-card">
    <%= image_tag "branding/originals/christmas-fair.jpeg", class: "event-logo", alt: "Mister Wiz Christmas Fair" %>
  </div>
  <div class="hero-copy">
    <span class="eyebrow"><%= t("dashboard.eyebrow") %></span>
    <h1><%= t("dashboard.title") %></h1>
    <p><%= t("dashboard.subtitle") %></p>
  </div>
  <div class="hero-scene" aria-hidden="true">
    <div class="santa-hat"><i></i></div>
    <div class="christmas-tree small-tree"><span>★</span></div>
    <div class="christmas-tree large-tree"><span>★</span></div>
    <div class="gift gift-red"></div>
    <div class="gift gift-purple"></div>
  </div>
</section>

<% if @products.none? %>
  <section class="empty-state">
    <h2><%= t("dashboard.no_products") %></h2>
    <p><%= t("dashboard.run_seeds") %></p>
  </section>
<% else %>
  <div class="cashier-layout" data-controller="cart" data-cart-locale-value="<%= current_locale %>" data-cart-currency-value="BRL">
    <section class="product-stage" aria-label="<%= t('dashboard.products') %>">
      <div class="section-heading">
        <div><span class="eyebrow"><%= t("dashboard.step_one") %></span><h2><%= t("dashboard.choose_products") %></h2></div>
        <button class="text-button" type="button" data-cart-target="clearButton" data-action="cart#clear"><%= t("dashboard.clear") %></button>
      </div>

      <div class="product-grid">
        <% @products.each do |product| %>
          <article class="product-card product-<%= product.code.dasherize %>"
                   data-cart-target="product"
                   data-code="<%= product.code %>"
                   data-name="<%= product.localized_name %>"
                   data-price="<%= product.price_cents %>"
                   data-stock="<%= product.available_stock_quantity %>"
                   data-capacity="<%= product.capacity_quantity %>"
                   data-serving="<%= product.serving_size %>"
                   data-available="<%= product.available_servings %>">
            <div class="product-card-top">
              <span class="product-badge"><%= t("products.codes.#{product.code}") %></span>
              <strong><%= money(product.price_cents) %></strong>
            </div>

            <div class="product-visual" aria-hidden="true">
              <% case product.code %>
              <% when "hot_chocolate" %>
                <div class="thermos">
                  <div class="thermos-cap"></div><div class="thermos-handle"></div>
                  <div class="thermos-body">
                    <div class="chocolate-fill" data-cart-fill style="height: <%= product.stock_percentage %>%"></div>
                    <span class="thermos-shine"></span>
                  </div>
                </div>
                <div class="steam"><i></i><i></i><i></i></div>
              <% when "brownie" %>
                <div class="brownie-tray" data-cart-pieces>
                  <% product.available_servings.times do %><span class="brownie-piece stock-piece"><i></i></span><% end %>
                  <% if product.available_servings.zero? %><span class="visual-empty">0</span><% end %>
                </div>
              <% else %>
                <div class="fishing-pond" data-cart-pieces>
                  <% product.available_servings.times do |index| %><span class="prize-fish stock-piece fish-<%= index % 3 %>"><i></i></span><% end %>
                  <% if product.available_servings.zero? %><span class="visual-empty">0</span><% end %>
                </div>
              <% end %>
            </div>

            <div class="product-info">
              <h3><%= product.localized_name %></h3>
              <p class="stock-copy"><span><%= t("dashboard.in_stock") %></span><strong data-cart-stock-label><%= stock_label(product) %></strong></p>
              <% if product.reserved_quantity.positive? %><small class="reserved-copy"><%= t("dashboard.reserved_for_pix", quantity: stock_label(product, product.reserved_quantity)) %></small><% end %>
              <% if product.hot_chocolate? %>
                <small><%= t("dashboard.cups_available", count: product.available_servings, size: product.serving_size) %></small>
              <% else %>
                <small><%= t("dashboard.available_to_sell", count: product.available_servings) %></small>
              <% end %>
            </div>

            <div class="quantity-picker">
              <button type="button" data-cart-target="quantityButton" data-action="cart#remove" data-code="<%= product.code %>" aria-label="<%= t('dashboard.remove_one', product: product.localized_name) %>">−</button>
              <output data-cart-target="quantity" data-code="<%= product.code %>">0</output>
              <button type="button" data-cart-target="quantityButton" data-action="cart#add" data-code="<%= product.code %>" <%= "disabled" if product.available_servings.zero? %> aria-label="<%= t('dashboard.add_one', product: product.localized_name) %>">+</button>
            </div>
          </article>
        <% end %>
      </div>

      <%= form_with url: cash_checkouts_path, scope: :checkout, class: "cash-checkout-form order-checkout-card", data: { cart_target: "checkoutForm", action: "submit->cart#submitCash" } do |form| %>
        <%= form.hidden_field :checkout_token, value: @checkout_token %>
        <% @products.each do |product| %>
          <%= hidden_field_tag "checkout[quantities][#{product.code}]", 0, data: { cart_target: "quantityInput", code: product.code } %>
        <% end %>

        <div class="order-summary-heading">
          <div><span class="eyebrow"><%= t("dashboard.step_two") %></span><h3><%= t("dashboard.order_summary") %></h3></div>
          <div class="order-total"><span><%= t("dashboard.total") %></span><strong data-cart-target="total">R$ 0,00</strong></div>
        </div>
        <div class="cart-lines order-cart-lines" data-cart-target="cartLines" data-empty-message="<%= t('dashboard.empty_order') %>"><p><%= t("dashboard.empty_order") %></p></div>

        <div class="order-review-step" data-cart-target="reviewState">
          <p><%= t("dashboard.review_order") %></p>
          <button type="button" class="confirm-order-button" data-cart-target="confirmOrderButton" data-action="cart#confirmOrder" disabled><%= t("dashboard.confirm_order") %></button>
        </div>

        <div class="payment-step" data-cart-target="paymentState" hidden>
          <div class="confirmed-order"><span>✓ <%= t("dashboard.order_confirmed") %></span><button type="button" data-action="cart#editOrder"><%= t("dashboard.edit_order") %></button></div>
          <div class="payment-methods" aria-label="<%= t('dashboard.payment_method') %>">
            <button type="button" class="selected" data-cart-target="cashMethod" data-action="cart#selectCash"><%= t("dashboard.cash") %></button>
            <button type="button" data-cart-target="pixMethod" data-action="cart#selectPix"><%= t("dashboard.pix") %></button>
          </div>
          <div class="cash-payment-grid" data-cart-target="cashPayment">
            <label class="cash-field">
              <span><%= t("dashboard.amount_received") %></span>
              <div class="cash-input"><b>R$</b><%= form.number_field :amount_received_brl, min: 0, step: "0.01", inputmode: "decimal", data: { cart_target: "cashReceived", action: "input->cart#cashChanged" } %></div>
            </label>
            <div class="change-line"><span><%= t("dashboard.change") %></span><strong data-cart-target="change"><%= money(0) %></strong></div>
            <p class="cash-hint" data-cart-target="cashHint" data-waiting="<%= t('dashboard.enter_received') %>" data-ready="<%= t('dashboard.ready_to_confirm') %>"><%= t("dashboard.enter_received") %></p>
            <%= form.submit t("dashboard.confirm_cash"), class: "confirm-sale-button", disabled: true, data: { cart_target: "checkoutButton", submitting_label: t("dashboard.confirming") } %>
          </div>
          <div class="pix-payment-choice" data-cart-target="pixPayment" hidden>
            <p><%= t("dashboard.pix_ready") %></p>
            <%= button_tag t("dashboard.generate_pix"), type: "submit", formaction: pix_checkouts_path, formmethod: "post", class: "generate-pix-button", data: { cart_target: "pixButton", action: "cart#submitPix", submitting_label: t("dashboard.generating_pix") } %>
          </div>
        </div>
      <% end %>
    </section>

    <aside class="checkout-panel">
      <div class="section-heading compact"><div><span class="eyebrow"><%= t("dashboard.step_two") %></span><h2><%= t("dashboard.payment") %></h2></div></div>
      <div class="phone-frame is-locked" data-cart-target="phone">
        <div class="phone-speaker"></div>
        <div class="phone-screen">
          <div class="phone-status"><span>Christmas Fair</span><span>● ● ●</span></div>
          <div class="phone-lock" data-cart-target="lockState"><span class="lock-icon">⌁</span><strong><%= t("dashboard.phone_locked") %></strong><p><%= t("dashboard.select_to_unlock") %></p></div>
          <div class="phone-ready" data-cart-target="readyState" hidden>
            <span class="phone-brand">MISTER WIZ</span><h3><%= t("dashboard.pix_payment") %></h3>
            <div class="pix-placeholder"><span class="pix-diamond">◇</span><p><%= t("dashboard.pix_after_confirmation") %></p></div>
          </div>
        </div>
        <div class="phone-home"></div>
      </div>
      <div class="payment-note"><span>✦</span><p><%= t("dashboard.phone_pix_note") %></p></div>
    </aside>
  </div>
<% end %>
