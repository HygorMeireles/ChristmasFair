<% content_for :title, t("financial.page_title") %>

<section class="settings-hero financial-hero">
  <div><span class="eyebrow"><%= t("financial.eyebrow") %></span><h1><%= t("financial.title") %></h1><p><%= t("financial.subtitle") %></p></div>
  <%= link_to t("financial.back_to_cashier"), root_path, class: "button secondary" %>
</section>

<section class="financial-overview" aria-label="<%= t('financial.summary') %>">
  <article class="overall"><span><%= t("financial.overall_balance") %></span><strong><%= money(@overall_balance_cents) %></strong><small><%= t("financial.overall_balance_note") %></small></article>
  <article class="pix"><span><%= t("financial.pix_balance") %></span><strong><%= money(@pix_net_cents) %></strong><small><%= t("financial.pix_sales_note", fees: money(@pix_fees_cents)) %></small></article>
  <article class="cards"><span><%= t("financial.card_balance") %></span><strong><%= money(@card_net_cents) %></strong><small><%= t("financial.card_sales_note", fees: money(@card_fees_cents)) %></small></article>
  <article class="cash"><span><%= t("financial.cash_result") %></span><strong><%= money(@cash_result_cents) %></strong><small><%= t("financial.cash_result_note") %></small></article>
  <article class="expenses"><span><%= t("financial.paid_expenses") %></span><strong><%= money(@paid_expenses_cents) %></strong><small><%= t("financial.pending_summary", amount: money(@pending_expenses_cents)) %></small></article>
</section>

<details class="financial-breakdown">
  <summary><span><%= t("financial.show_details") %></span><small><%= t("financial.show_details_note") %></small></summary>
  <div class="financial-metrics secondary-metrics">
    <article><span><%= t("financial.gross_sales") %></span><strong><%= money(@gross_sales_cents) %></strong></article>
    <article><span><%= t("financial.pix_sales") %></span><strong><%= money(@pix_sales_cents) %></strong><small><%= t("financial.fee_line", fee: money(@pix_fees_cents)) %></small></article>
    <article><span><%= t("financial.card_sales") %></span><strong><%= money(@card_sales_cents) %></strong><small><%= t("financial.fee_line", fee: money(@card_fees_cents)) %></small></article>
    <article><span><%= t("financial.cash_sales") %></span><strong><%= money(@cash_sales_cents) %></strong></article>
    <article><span><%= t("financial.pending_expenses") %></span><strong><%= money(@pending_expenses_cents) %></strong></article>
    <article class="margin-metric"><span><%= t("financial.known_margin") %></span><strong><%= money(@gross_margin_cents) %></strong><small><%= t("financial.known_margin_note", revenue: money(@costed_revenue_cents), cost: money(@cost_of_goods_cents), count: @uncosted_items_count) %></small></article>
  </div>
</details>

<section class="finance-card profit-distribution-card">
  <div class="section-heading compact">
    <div><span class="eyebrow"><%= t("profit_distribution.eyebrow") %></span><h2><%= t("profit_distribution.title") %></h2></div>
    <strong class="distribution-total"><%= money(@profit_distribution.profit_cents) %></strong>
  </div>
  <p class="distribution-explanation"><%= t("profit_distribution.explanation") %></p>
  <% if @overall_balance_cents.negative? %><p class="distribution-warning"><%= t("profit_distribution.negative_balance") %></p><% end %>
  <div class="distribution-pools">
    <span><%= t("profit_distribution.equal_pool", amount: money(@profit_distribution.base_pool_cents)) %></span>
    <span><%= t("profit_distribution.preparation_pool", amount: money(@profit_distribution.preparation_pool_cents)) %></span>
  </div>
  <div class="distribution-list">
    <% @profit_distribution.entries.each do |entry| %>
      <% name = @event_setting.public_send(entry.name_field).presence || t("profit_distribution.roles.#{entry.name_field}") %>
      <article>
        <div><strong><%= name %></strong><small><%= t("profit_distribution.role_descriptions.#{entry.role}") %></small></div>
        <span class="distribution-percentage"><%= entry.preparation_lead ? "21,67%" : "11,67%" %></span>
        <b><%= money(entry.amount_cents) %></b>
      </article>
    <% end %>
  </div>
  <small class="distribution-note"><%= t("profit_distribution.internal_note") %></small>
</section>

<div class="financial-content-grid">
  <section class="finance-card product-performance-card">
    <div class="section-heading compact"><div><span class="eyebrow"><%= t("financial.sales_eyebrow") %></span><h2><%= t("financial.by_product") %></h2></div></div>
    <% if @sales_by_product.empty? %><p class="finance-empty"><%= t("financial.no_sales") %></p><% else %>
      <div class="performance-list">
        <% @sales_by_product.each do |entry| %>
          <div><span class="performance-icon <%= entry[:code] %>"><%= entry[:code] == "brownie" ? "▦" : entry[:code] == "hot_chocolate" ? "♨" : "◇" %></span><p><strong><%= entry[:product]&.localized_name || entry[:code].humanize %></strong><small><%= t("financial.items_sold", count: entry[:quantity]) %></small></p><b><%= money(entry[:revenue_cents]) %></b></div>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="finance-card recent-sales-card">
    <div class="section-heading compact"><div><span class="eyebrow"><%= t("financial.history_eyebrow") %></span><h2><%= t("financial.recent_sales") %></h2></div></div>
    <% if @recent_orders.empty? %><p class="finance-empty"><%= t("financial.no_sales") %></p><% else %>
      <div class="finance-table-wrap"><table class="finance-table"><thead><tr><th><%= t("financial.order") %></th><th><%= t("financial.items") %></th><th><%= t("financial.payment") %></th><th><%= t("financial.total") %></th></tr></thead><tbody>
        <% @recent_orders.each do |order| %><tr><td><strong>#<%= order.number %></strong><small><%= l(order.paid_at, format: :short) %></small></td><td><%= order.order_items.sum(&:quantity) %></td><td><%= t("financial.payment_methods.#{order.payment_method}") %><% if order.provider_fee_cents.positive? %><small><%= t("financial.fee_line", fee: money(order.provider_fee_cents)) %></small><% end %></td><td><strong><%= money(order.net_total_cents) %></strong><small><%= t("financial.net_value") if order.provider_fee_cents.positive? %></small></td></tr><% end %>
      </tbody></table></div>
    <% end %>
  </section>
</div>

<details class="finance-card expense-management">
  <summary><div><span class="eyebrow"><%= t("financial.expenses_eyebrow") %></span><strong><%= t("financial.manage_expenses") %></strong></div><small><%= t("financial.expense_summary", paid: money(@paid_expenses_cents), pending: money(@pending_expenses_cents)) %></small></summary>
  <div class="expense-management-grid">
    <div>
      <h2><%= t("financial.new_expense") %></h2>
      <%= form_with model: @expense, class: "expense-form", data: { controller: "expense-calculator", action: "input->expense-calculator#calculate" } do |form| %>
        <label class="wide"><span><%= t("financial.description") %></span><%= form.text_field :description, required: true, maxlength: 120 %></label>
        <label><span><%= t("financial.category") %></span><%= form.select :category, Expense::CATEGORIES.map { |category| [t("financial.categories.#{category}"), category] }, required: true %></label>
        <label><span><%= t("financial.quantity") %></span><%= form.number_field :quantity, min: 1, required: true, data: { expense_calculator_target: "quantity" } %></label>
        <label><span><%= t("financial.unit_amount") %></span><div class="input-prefix"><b>R$</b><%= form.text_field :unit_amount_brl, required: true, inputmode: "decimal", placeholder: "0,00", data: { expense_calculator_target: "unitAmount" } %></div></label>
        <label><span><%= t("financial.discount") %></span><div class="input-prefix"><b>R$</b><%= form.text_field :discount_brl, inputmode: "decimal", placeholder: "0,00", data: { expense_calculator_target: "discount" } %></div></label>
        <div class="expense-calculated-total"><span><%= t("financial.calculated_total") %></span><strong data-expense-calculator-target="total"><%= money(0) %></strong></div>
        <label><span><%= t("financial.date") %></span><%= form.date_field :incurred_on, required: true %></label>
        <label><span><%= t("financial.status") %></span><%= form.select :status, Expense::STATUSES.map { |status| [t("financial.statuses.#{status}"), status] } %></label>
        <label class="wide"><span><%= t("financial.notes") %></span><%= form.text_area :notes, maxlength: 500, rows: 2 %></label>
        <%= form.submit t("financial.save_expense"), class: "button primary" %>
      <% end %>
    </div>
    <div>
      <h2><%= t("financial.expense_history") %></h2>
      <% if @expenses.empty? %><p class="finance-empty"><%= t("financial.no_expenses") %></p><% else %>
        <div class="expense-list">
          <% @expenses.each do |expense| %>
            <article><div><span class="expense-category"><%= t("financial.categories.#{expense.category}") %></span><strong><%= expense.description %></strong><small><%= l(expense.incurred_on) %> · <%= t("financial.expense_calculation", quantity: expense.quantity, unit: money(expense.unit_amount_cents), discount: money(expense.discount_cents)) %><%= " · #{expense.notes}" if expense.notes.present? %></small></div><div class="expense-value"><strong><%= money(expense.amount_cents) %></strong><span class="status-pill <%= expense.paid? ? 'done' : 'waiting' %>"><%= t("financial.statuses.#{expense.status}") %></span><% unless expense.paid? %><%= button_to t("financial.mark_paid"), mark_paid_expense_path(expense), method: :patch, class: "text-button" %><% end %></div></article>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</details>
