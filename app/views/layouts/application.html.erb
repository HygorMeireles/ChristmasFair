<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mister Wiz Christmas Fair" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Christmas Fair">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "branding/originals/mister-wiz-symbol.jpeg", type: "image/jpeg" %>
    <%= favicon_link_tag "branding/originals/mister-wiz-symbol.jpeg", rel: "apple-touch-icon", type: "image/jpeg" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="christmas-shell <%= 'customer-display-mode' if customer_display? %>"
        data-controller="display"
        data-display-customer-value="<%= customer_display? %>"
        data-display-sync-url-value="<%= request.fullpath if controller_name.in?(%w[dashboard pix_checkouts]) %>">
    <div class="ambient-snow" aria-hidden="true"></div>
    <header class="site-header">
      <%= link_to root_path, class: "brand-lockup", aria: { label: "Mister Wiz Christmas Fair" } do %>
        <%= image_tag "branding/originals/mister-wiz-logo.png", class: "brand-logo", alt: "Mister Wiz" %>
        <span class="brand-divider" aria-hidden="true"></span>
        <span class="brand-event">Christmas Fair</span>
      <% end %>

      <% if authenticated? %><nav class="header-actions" aria-label="<%= t('navigation.label') %>">
        <%= link_to t("navigation.cashier"), root_path, class: "nav-link #{'active' if controller_name == 'dashboard'}" %>
        <%= link_to t("navigation.fishing"), fishing_tickets_path, class: "nav-link #{'active' if controller_name == 'fishing_tickets'}" %>
        <%= link_to t("navigation.financial"), financial_path, class: "nav-link #{'active' if controller_name.in?(%w[financial expenses])}" %>
        <%= link_to t("navigation.settings"), products_path, class: "nav-link #{'active' if controller_name == 'products'}" %>
        <%= link_to t("navigation.customer_display"), root_path(customer_display: 1), class: "nav-link customer-display-link", target: "_blank", rel: "noopener" %>
        <button type="button" class="nav-link freeze-display-button" data-display-target="toggleButton" data-action="display#toggle" data-freeze-label="<%= t('navigation.freeze_display') %>" data-unfreeze-label="<%= t('navigation.unfreeze_display') %>"><%= t("navigation.freeze_display") %></button>
        <div class="locale-switch" aria-label="<%= t('navigation.language') %>">
          <%= link_to "PT", locale_switch_path("pt-BR"), class: current_locale == "pt-BR" ? "selected" : nil %>
          <%= link_to "EN", locale_switch_path("en"), class: current_locale == "en" ? "selected" : nil %>
        </div>
        <%= button_to t("navigation.logout"), logout_path, method: :delete, class: "nav-link logout-button" %>
      </nav><% end %>
    </header>

    <% if notice.present? %><div class="flash notice"><%= notice %></div><% end %>
    <% if alert.present? %><div class="flash alert"><%= alert %></div><% end %>

    <main><%= yield %></main>

    <footer class="site-footer">
      <span>✦ Mister Wiz</span>
      <span><%= t("footer.date") %></span>
    </footer>
    <div class="customer-freeze-overlay" data-display-target="overlay" hidden>
      <div class="freeze-logo-card"><%= image_tag "branding/originals/christmas-fair.jpeg", alt: "Mister Wiz Christmas Fair" %></div>
      <span class="eyebrow"><%= t("display.frozen_eyebrow") %></span>
      <h1><%= t("display.frozen_title") %></h1>
      <p><%= t("display.frozen_message") %></p>
      <div class="freeze-lights" aria-hidden="true">●　●　●　●　●</div>
    </div>
  </body>
</html>
