<% content_for :title, t("products.page_title") %>

<section class="settings-hero">
  <div><span class="eyebrow"><%= t("products.eyebrow") %></span><h1><%= t("products.title") %></h1><p><%= t("products.subtitle") %></p></div>
  <%= link_to t("products.back_to_cashier"), root_path, class: "button secondary" %>
</section>

<section class="event-settings-card">
  <div class="event-fee-copy">
    <span class="eyebrow"><%= t("event_settings.eyebrow") %></span>
    <h2><%= t("event_settings.title") %></h2>
    <p><%= t("event_settings.fee_explanation") %></p>
  </div>
  <%= form_with model: @event_setting, url: event_setting_path, method: :patch, class: "event-settings-form" do |form| %>
    <label><span><%= t("event_settings.mercado_pago_fee") %></span><div class="input-suffix fee-input"><%= form.text_field :mercado_pago_fee_percent, inputmode: "decimal", required: true %><b>%</b></div></label>
    <label><span><%= t("event_settings.debit_card_fee") %></span><div class="input-suffix fee-input"><%= form.text_field :debit_card_fee_percent, inputmode: "decimal", required: true %><b>%</b></div></label>
    <label><span><%= t("event_settings.credit_card_fee") %></span><div class="input-suffix fee-input"><%= form.text_field :credit_card_fee_percent, inputmode: "decimal", required: true %><b>%</b></div></label>
    <%= form.submit t("event_settings.save"), class: "button primary" %>
  <% end %>
</section>

<section class="settings-grid">
  <% @products.each do |product| %>
    <article class="settings-card" id="<%= dom_id(product) %>">
      <header>
        <div class="settings-icon <%= product.code %>"><%= product.code == "brownie" ? "▦" : product.code == "hot_chocolate" ? "♨" : "◇" %></div>
        <div><span class="product-badge"><%= t("products.codes.#{product.code}") %></span><h2><%= product.localized_name %></h2></div>
        <div class="inventory-summary compact">
          <div><span><%= t("products.current_stock") %></span><strong><%= stock_label(product) %></strong></div>
          <div><span><%= t("products.sellable") %></span><strong><%= product.available_servings %></strong></div>
        </div>
      </header>

      <div class="quick-stock-panel">
        <div class="quick-stock-copy"><strong><%= t("products.quick_stock") %></strong><small><%= t("products.quick_stock_help") %></small></div>
        <%= form_with url: product_stock_movements_path(product), class: "stock-form quick-stock-form" do |form| %>
          <label><span><%= t("products.quantity") %></span><div class="input-suffix"><%= form.number_field :amount, min: 1, required: true, placeholder: "0" %><b><%= product.stock_unit %></b></div></label>
          <label class="stock-note"><span><%= t("products.note_optional") %></span><%= form.text_field :note, maxlength: 140, placeholder: t("products.note_placeholder") %></label>
          <div class="stock-action-buttons">
            <%= form.button t("products.add_stock"), name: :stock_action, value: "add", class: "button stock-add-button" %>
            <%= form.button t("products.remove_stock"), name: :stock_action, value: "remove", class: "button stock-remove-button" %>
          </div>
        <% end %>
      </div>

      <div class="product-tools">
        <details class="tool-panel product-config-panel">
          <summary><span><%= t("products.edit_product") %></span><small><%= money(product.price_cents) %> · <%= t(product.active? ? "products.active" : "products.inactive") %></small></summary>
          <%= form_with model: product, class: "settings-form compact-settings-form" do |form| %>
            <div class="field-pair">
              <label><span><%= t("products.name_pt") %></span><%= form.text_field :name_pt, required: true %></label>
              <label><span><%= t("products.name_en") %></span><%= form.text_field :name_en, required: true %></label>
            </div>
            <div class="field-pair">
              <label><span><%= t("products.price") %></span><div class="input-prefix"><b>R$</b><%= form.text_field :price_brl, inputmode: "decimal", required: true %></div></label>
              <% if product.hot_chocolate? %><label><span><%= t("products.cup_size") %></span><div class="input-suffix"><%= form.number_field :serving_size, min: 1, required: true %><b>ml</b></div></label><% end %>
            </div>
            <% if product.hot_chocolate? %><label><span><%= t("products.capacity") %></span><div class="input-suffix"><%= form.number_field :capacity_quantity, min: product.stock_quantity, required: true %><b>ml</b></div></label><% end %>
            <label class="checkbox-field"><%= form.check_box :active %><span><%= t("products.show_at_cashier") %></span></label>
            <%= form.submit t("products.save"), class: "button primary" %>
          <% end %>
        </details>

        <details class="tool-panel batch-panel">
          <summary><span><%= t("stock_batches.add_batch") %></span><small><%= t("stock_batches.with_cost") %></small></summary>
          <p><%= t("stock_batches.explanation") %></p>
          <%= form_with url: product_stock_batches_path(product), scope: :stock_batch, class: "batch-form" do |form| %>
            <label><span><%= t("stock_batches.description") %></span><%= form.text_field :description, required: true, maxlength: 120, placeholder: t("stock_batches.description_placeholder") %></label>
            <label><span><%= t("stock_batches.quantity") %></span><div class="input-suffix"><%= form.number_field :quantity, min: 1, required: true %><b><%= product.stock_unit %></b></div></label>
            <label><span><%= t("stock_batches.total_cost") %></span><div class="input-prefix"><b>R$</b><%= form.text_field :total_cost_brl, inputmode: "decimal", required: true, placeholder: "0,00" %></div></label>
            <label><span><%= t("stock_batches.received_on") %></span><%= form.date_field :received_on, value: Date.current, required: true %></label>
            <label class="checkbox-field batch-expense-check"><%= form.check_box :register_expense, checked: true %><span><%= t("stock_batches.register_expense") %></span></label>
            <%= form.submit t("stock_batches.create"), class: "button batch-button" %>
          <% end %>
        </details>

        <% if product.stock_batches.any? %>
          <div class="batch-list">
            <h3><%= t("stock_batches.recent") %></h3>
            <% product.stock_batches.sort_by { |batch| [batch.received_on, batch.id] }.reverse.first(4).each do |batch| %>
              <div><p><strong><%= batch.description %></strong><small><%= l(batch.received_on) %> · <%= t("stock_batches.remaining", remaining: batch.remaining_quantity, initial: batch.initial_quantity, unit: product.stock_unit) %></small></p><span><%= money(batch.total_cost_cents) %></span></div>
            <% end %>
          </div>
        <% end %>

        <% if product.stock_movements.any? %>
          <details class="tool-panel movement-history">
            <summary><span><%= t("products.history") %></span><small><%= t("products.last_movements", count: [product.stock_movements.size, 6].min) %></small></summary>
            <ol>
              <% product.stock_movements.order(created_at: :desc).limit(6).each do |movement| %>
                <li><span class="movement-delta <%= movement.quantity_delta.positive? ? 'positive' : 'negative' %>"><%= movement.quantity_delta.positive? ? "+" : "" %><%= movement.quantity_delta %></span><span><%= t("inventory.types.#{movement.movement_type}") %><small><%= l(movement.created_at, format: :short) %> · <%= t("products.balance") %>: <%= movement.stock_after %></small></span></li>
              <% end %>
            </ol>
          </details>
        <% end %>
      </div>
    </article>
  <% end %>
</section>
